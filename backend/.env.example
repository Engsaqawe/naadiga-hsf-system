# Copy to .env on the Namecheap server and fill in real values.
# Do not commit real passwords.

# cPanel → MySQL® Databases (use the full DB username Namecheap shows)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/DATABASE_NAME
SECRET_KEY=change-me-to-a-long-random-string

# Public contact email (display only)
CLUB_OFFICIAL_EMAIL=hsfstudentsclub@gmail.com

# Namecheap cPanel mail (Connect Devices for noreply@…)
# If SMTP fails, try MAIL_SERVER=premium24.web-hosting.com
MAIL_SERVER=naadigaardaydahsf.com
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=noreply@naadigaardaydahsf.com
MAIL_PASSWORD=your-mailbox-password
MAIL_DEFAULT_SENDER=noreply@naadigaardaydahsf.com
